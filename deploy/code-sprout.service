[Unit]
Description=code-sprout-api (Spring Boot + MySQL via docker compose)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/code-sprout/prod.env
WorkingDirectory=/home/kvi5hnu/Desktop/code-sprout-api
ExecStart=/usr/bin/docker compose up -d --wait --wait-timeout 180
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose up -d --wait --wait-timeout 180
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
